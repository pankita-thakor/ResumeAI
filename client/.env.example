# Vite inlines VITE_* at BUILD time and only reads env files in this folder (client/).
# A VITE_API_URL in server/.env is ignored by the build.

# Local dev: leave unset. vite.config.ts proxies /api to the API process on PORT (server/.env),
# so relative /api/... requests work without this variable.

# Production (https://resume-ai-seven-swart.vercel.app): set this in the Vercel project's
# Environment Variables to the API origin — no trailing slash, no /api suffix — then REDEPLOY.
# An env change alone does nothing; the value is baked in at build time.
# VITE_API_URL=https://resumeai-api.onrender.com
