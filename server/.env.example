PORT=3001
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/resumeai
# Secret for JWT signing
JWT_SECRET=your_jwt_secret_here
# Comma-separated browser origins allowed by CORS (required when API and UI are on different
# domains, e.g. Vercel + Render). No trailing slash.
#
# An entry may contain `*`, which matches ONE hostname label (any characters except . and /).
# Vercel gives every preview deployment a new hostname, so a wildcard avoids having to edit
# this on every push. Include both the production domain and the preview pattern:
# CLIENT_ORIGIN=https://resume-ai-seven-swart.vercel.app,https://*-pankitathakor-4970s-projects.vercel.app
#
# Leaving this empty reflects whatever Origin the request carries — convenient locally,
# but do not ship it that way.

# Base URL of the UI, used to build the password-reset link in POST /api/auth/forgot-password.
# Defaults to http://localhost:5173, which is wrong in production.
# CLIENT_URL=https://resume-ai-seven-swart.vercel.app

# ---------------------------------------------------------------------------
# Password reset email (SMTP). Any SMTP provider works. When these are unset the reset
# link is printed to this server's console instead — fine for local dev, useless in prod.
# Check GET /api/health → config.smtp to see whether the server picked them up.
#
# Option A — Brevo (recommended free tier: 300 emails/day, no domain needed)
#   1. Sign up at https://www.brevo.com  →  verify your own email address
#   2. SMTP & API → SMTP → create an SMTP key
#   3. SMTP_USER is the login Brevo shows you (a xxxxx@smtp-brevo.com address),
#      SMTP_PASS is the generated SMTP key (NOT your account password)
#   4. MAIL_FROM must use an email you verified in Brevo (Senders → add a sender)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ResumeAI <you@yourverifiedaddress.com>
#
# Option B — Gmail (free, 500/day, no domain needed; needs 2-Step Verification on)
#   1. Google Account → Security → 2-Step Verification → App passwords
#   2. Generate one for "Mail"; use the 16-character value as SMTP_PASS
#      (your normal Gmail password will NOT work)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_16_char_app_password
# MAIL_FROM=ResumeAI <you@gmail.com>
#
# Option C — Resend (3,000/month free). Without a verified domain the sandbox sender
#   onboarding@resend.dev can ONLY deliver to your own Resend account address, so it is
#   fine for testing but not for real users until you verify a domain.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your_resend_api_key
# MAIL_FROM=onboarding@resend.dev
#
# Port note: use 465 only for implicit TLS; 587 (and Brevo's 2525) use STARTTLS.
# ---------------------------------------------------------------------------

# The browser's API origin is a CLIENT-side build variable: set VITE_API_URL in client/.env
# (or the UI host's env vars), not here. Vite never reads this file. See client/.env.example.
# In local dev leave it unset — vite.config.ts proxies /api to this server's PORT.

# PDF uploads: POST /api/ask-pdf (multipart field resumePdf, max 5 MB) — text is extracted,
# then the same answerFromResume + embeddings flow runs as for pasted text.

# Paste your key from https://aistudio.google.com/app/apikey
# Copy this file to server/.env and fill in — never commit .env
# GEMINI_API_KEY=

# Chat model (answers). Primary defaults to gemini-3-flash-preview; on 503/429/404/unknown model,
# the server retries then tries fallbacks (see resolveChatModelChain in server code).
# you can pin a model, e.g. GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODEL=gemini-3-flash-preview
# Optional extra fallbacks (comma-separated). Built-in defaults: gemini-2.5-flash, gemini-2.5-flash-lite.
# Avoid gemini-1.5-flash on v1beta — often 404; list models: https://ai.google.dev/api/rest/v1beta/models/list
# GEMINI_MODEL_FALLBACKS=

# Retries when Google returns 503/429/overload (optional)
# GEMINI_RETRY_ATTEMPTS=5
# GEMINI_RETRY_BASE_MS=1500

# Embedding model (retrieves relevant resume chunks before answering)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Options: gemini-embedding-001, text-embedding-004 (see Gemini embeddings docs)

# In-memory LRU cache for embedding vectors (same text + model = no repeat API call)
# GEMINI_EMBED_CACHE_MAX=3000
# GEMINI_EMBED_CACHE=0           # disable cache
# GEMINI_EMBED_CACHE_LOG=1       # log hits vs API batches per request

# Speed: skip embedding/RAG — one chat call with full resume (faster; worse for huge CVs / narrow retrieval)
# GEMINI_SKIP_RAG=true

# Full-answer cache: only exact same resume + question text (rephrasing = cache miss)
# GEMINI_ANSWER_CACHE_MAX=200
# GEMINI_ANSWER_CACHE=0           # disable

# RAG: resume is split into semantic segments (paragraphs / sentences), then embeddings
# pick the top-K segments for the question — not a fixed number of pieces.
# GEMINI_EMBED_CHUNK_CHARS=1200   # max size when merging paragraph units (not "force N tiles")
# GEMINI_EMBED_CHUNK_OVERLAP=150  # only for oversized blocks without enough line breaks
# GEMINI_EMBED_TOP_CHUNKS=6       # how many best-matching segments go to the chat model
# When segment count is above GEMINI_EMBED_TOP_CHUNKS, one segment may be omitted (unless full
# coverage). When count is within top-K, all segments are sent. To also allow every segment
# when truncating long resumes, set:
# GEMINI_EMBED_ALLOW_FULL_COVERAGE=true

# Pinecone (optional): when PINECONE_API_KEY and PINECONE_INDEX are set, segment vectors are
# upserted per resume (namespace = sha256 of resume text) and top-K is chosen via Pinecone
# query instead of in-process cosine. Set PINECONE_VECTOR_STORE=0 to disable while keys exist.
# PINECONE_ONLY=true — never fall back to in-memory ranking; fail the request if Pinecone errors.
# Env is loaded from server/.env even when you run `npm run dev` from the repo root.
#
# PINECONE_VECTOR_DIMENSION (e.g. 768) must equal your Pinecone index dimensions; the API also
# passes this to Gemini embedContent as outputDimensionality so vectors match the index.
# Optional alias: GEMINI_EMBEDDING_OUTPUT_DIM (same value).
#
# In the Pinecone console (https://app.pinecone.io): create a dense index whose name matches
# PINECONE_INDEX, with the same dimension and a metric like cosine or dotproduct. No website/UI
# code changes are required — only this server env and the Pinecone project.
#
# PINECONE_API_KEY=
# PINECONE_INDEX=resumeai
# PINECONE_VECTOR_DIMENSION=768
# PINECONE_VECTOR_STORE=0
# After POST /api/resume/index, segment texts are kept in RAM for finalizeRagChunks (restart = re-index).
# RESUME_SESSION_MAX=500

# API index: GET http://127.0.0.1:3001/api  — lists routes
# Health: GET http://127.0.0.1:3001/api/health
# Pinecone probe: GET http://127.0.0.1:3001/api/pinecone-test
