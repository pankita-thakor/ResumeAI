{
  "name": "resume-ai",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client && npm run build -w server",
    "reset-db": "npm run reset-db -w server --",
    "reset-db:force": "npm run reset-db -w server -- --yes"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^7.1.0",
    "mongodb": "^7.1.1"
  }
}
